{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lare-terminal",
  "version": "2.0.0",
  "identifier": "dev.lare.terminal",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Lare Terminal",
        "width": 1064,
        "height": 140,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "visible": false,
        "contentProtected": false
      }
    ]
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
