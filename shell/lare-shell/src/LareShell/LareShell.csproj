<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Nome dell'eseguibile (lare-shell.exe, spec §7) e namespace radice del codice. -->
    <AssemblyName>lare-shell</AssemblyName>
    <RootNamespace>LareShell</RootNamespace>
    <Version>2.0.2</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Il NuGet Microsoft.PowerShell.SDK porta le risorse localizzate di decine di lingue:
         teniamo solo l'inglese nell'output (≈ -30 MB nel publish). -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- RID esplicito: senza, gli asset specifici di Windows del NuGet Microsoft.PowerShell.SDK
         (System.Management.Automation.dll compresa) finiscono in runtimes\win\lib\net10.0\ e
         $PSHOME diventa QUELLA cartella — powershell.config.json accanto all'exe non verrebbe
         letto (scoperto nel Task 4). Con il RID gli asset stanno nella radice dell'output, come
         nel publish del deploy (-r win-x64, framework-dependent). -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.PowerShell.SDK" Version="7.6.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- lare-shell.exe è Windows-only nell'MVP (ConPTY, PSReadLine su console Win32; ADR-015
         prevede Linux/macOS pwsh-flavored più avanti, non ora). Dichiariamo la piattaforma
         supportata a livello di assembly invece di zittire l'analizzatore CA1416 (membri di
         System.Console come Console.Title, CursorSize, SetWindowSize/Position, SetBufferSize,
         usati in LareRawUI.cs, sono "Windows-only" secondo l'analizzatore quando il
         TargetFramework è "net10.0" generico, non "net10.0-windows"): così il compilatore SA che
         gireremo solo su Windows, invece di doverlo ririchiedere per ogni file futuro che tocchi
         API Win32-specifiche. Niente TFM "net10.0-windows" (cambierebbe RID/pubblicazione oltre
         lo scopo di questo fix) e niente attributo scritto a mano in un file .cs: questo
         ItemGroup genera [assembly: SupportedOSPlatformAttribute("windows")] via
         WriteCodeFragment, la via ufficiale per farlo da solo project file (vedi "Suppress
         warnings" in learn.microsoft.com/dotnet/standard/analyzers/platform-compat-analyzer). -->
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>windows</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- Execution policy di scope LocalMachine (spec §4.4/§13, ADR-019): PowerShell 7 la legge da
         $PSHOME\powershell.config.json, e $PSHOME di un'app che ospita il motore è la cartella
         dell'app. Copiato accanto all'exe (e, transitivamente, nell'output dei test). -->
    <None Include="powershell.config.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- I tipi sono `internal`: i test li vedono grazie a questo attributo di assembly. -->
    <InternalsVisibleTo Include="LareShell.Tests" />
  </ItemGroup>

</Project>
