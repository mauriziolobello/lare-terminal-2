<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- RID esplicito: senza, gli asset specifici di Windows del NuGet Microsoft.PowerShell.SDK
         (System.Management.Automation.dll compresa) finiscono in runtimes\win\lib\net10.0\ e
         $PSHOME diventa QUELLA cartella — powershell.config.json accanto all'exe non verrebbe
         letto (scoperto nel Task 4). Con il RID gli asset stanno nella radice dell'output, come
         nel publish del deploy (-r win-x64, framework-dependent). -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LareShell\LareShell.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Stessa dichiarazione di LareShell.csproj (vedi il commento lì): questo progetto chiama
         tipi Windows-only del progetto referenziato (LareHost, OrchestratorClient, ecc., ora
         marcati [SupportedOSPlatform("windows")] a livello di assembly). Senza la stessa
         dichiarazione qui, l'analizzatore CA1416 segnalerebbe ogni singola chiamata a quei tipi
         come "raggiungibile da tutte le piattaforme" — verificato: senza questo ItemGroup la
         build di questo progetto produce 234 avvisi CA1416, non solo sui membri Console-specifici
         di LareRawUI ma su qualunque tipo pubblico/internal dell'assembly referenziato. -->
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>windows</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
