{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lare-terminal-window",
  "version": "0.1.0",
  "identifier": "dev.lare.terminal.spike2",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Lare Terminal (spike 2)",
        "width": 1000,
        "height": 650,
        "center": true,
        "decorations": true,
        "transparent": false,
        "resizable": true,
        "visible": true
      }
    ]
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
